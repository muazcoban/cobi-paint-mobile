<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- App Store export that uploads the build to App Store Connect (TestFlight)
     with the Apple account signed in to Xcode. tool/release/ios_testflight.sh
     picks this file with --upload. manageAppVersionAndBuildNumber is off so the
     build number stays the one in pubspec.yaml. -->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>upload</string>
	<key>teamID</key>
	<string>5MY44SLWZU</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>uploadSymbols</key>
	<true/>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
	<key>stripSwiftSymbols</key>
	<true/>
</dict>
</plist>
